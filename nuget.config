<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Pinned to a single source so the build is reproducible on any machine and does not depend on
    whatever feeds happen to be configured globally. Central Package Management also requires
    source mapping once more than one source is in play.

    To add a private feed, register it under packageSources and give it its own <packageSource>
    mapping with the package prefixes it owns, for example <package pattern="Circle360.*" />.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
