{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "MassTransit": "Warning"
    }
  },
  "AllowedHosts": "*",

  "RabbitMq": {
    "Host": "localhost",
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest"
  },

  "Playwright": {
    "MaxConcurrentRenders": 4,
    "MaxRendersPerBrowser": 500,
    "RenderTimeoutMs": 30000,
    "EnableJavaScript": false,
    "AllowedHosts": [],
    "LaunchArgs": [ "--disable-dev-shm-usage", "--disable-gpu" ]
  },

  "Storage": {
    "RootPath": "data/files",
    "PublicBaseUrl": "http://localhost:8080"
  },

  "TemplateStore": {
    "RootPath": "Templates",
    "AuthoredRootPath": "data/templates"
  },

  "TemplateEngine": {
    "StrictMode": false
  },

  "JobStore": {
    "RetentionHours": 24
  }
}
