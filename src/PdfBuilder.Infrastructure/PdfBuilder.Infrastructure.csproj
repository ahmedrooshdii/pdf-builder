<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Adapters: one folder per port in Application/Abstractions. This is the only project that
    references Playwright, Scriban or the file system.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Blocks.ServiceDefaults.EntityFramework\Blocks.ServiceDefaults.EntityFramework.csproj" />
    <ProjectReference Include="..\PdfBuilder.Application\PdfBuilder.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="MassTransit.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Scriban" />
  </ItemGroup>

  <!-- So the mapping to Playwright's options can be tested without launching a browser. -->
  <ItemGroup>
    <InternalsVisibleTo Include="PdfBuilder.Infrastructure.Tests" />
  </ItemGroup>

</Project>
